{
  "name": "betterbooks",
  "version": "1.0.0",
  "description": "BetterBooks financial management application",
  "main": "index.js",
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "which npm && cd frontend && npm install --production=false && npm run build",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run start:dev",
    "client": "cd frontend && npm run dev",
    "install-all": "npm install && cd frontend && npm install && cd ../backend && npm install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/lodash.isequal": "^4.5.8",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@types/lodash.isequal": "^4.5.8",
    "bcrypt": "^6.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "lodash.isequal": "^4.5.0"
  }
}
