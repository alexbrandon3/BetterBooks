{
  "name": "betterbooks-backend",
  "version": "1.0.0",
  "description": "BetterBooks backend server",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "nodemon",
    "dev": "concurrently \"ts-node-dev --respawn --transpile-only src/index.ts\" \"npm run watch\"",
    "watch": "tsc -w",
    "build": "tsc",
    "test": "jest",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "npm run typeorm migration:run -- -d C:/Users/alexl/projects/BetterBooks/backend/typeorm.config.ts",
    "migration:revert": "npm run typeorm migration:revert -- -d C:/Users/alexl/projects/BetterBooks/backend/typeorm.config.ts",
    "seed:transactions": "ts-node src/scripts/seedTransactions.ts",
    "reset:demo": "ts-node src/scripts/resetDemoUser.ts",
    "seed:dashboard": "ts-node src/scripts/seedDashboard.ts",
    "reset:db": "ts-node src/scripts/resetDatabase.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.7.1",
    "reflect-metadata": "^0.1.13",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^18.19.110",
    "jest": "^29.4.0",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typeorm": "^0.3.24",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.8.3"
  }
}
