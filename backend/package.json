{
  "name": "betterbooks-backend",
  "version": "1.0.0",
  "description": "BetterBooks backend server",
  "main": "dist/app.js",
  "scripts": {
    "start": "dotenv -e .env -- node dist/app.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev": "dotenv -e .env -- ts-node-dev src/index.ts",
    "build": "tsc",
    "test": "jest"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.7.1",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.4.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^18.19.100",
    "jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
